{
  "name": "autogram-remote",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "AutoGram remote CDP smoke suite (Vite + frontend.exe)",
  "scripts": {
    "suite": "node run.mjs",
    "heal": "node heal-remote.mjs",
    "vite": "node core/vite_ensure.mjs",
    "ensure": "powershell -NoProfile -ExecutionPolicy Bypass -File ensure-remote.ps1",
    "build:exe": "powershell -NoProfile -ExecutionPolicy Bypass -File build-frontend-debug.ps1",
    "test:wait": "node --test core/wait_helpers.test.mjs",
    "health": "node -e \"import('./core/health_checker.mjs').then(async m=>{const c=JSON.parse(await import('node:fs').then(fs=>fs.readFileSync('./config/remote_config.json','utf8'))); console.log(JSON.stringify(await m.checkHealth(c),null,2))})\""
  },
  "dependencies": {
    "ws": "^8.21.1"
  }
}
