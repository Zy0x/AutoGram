px;\r\n  border-style: solid;\r\n  border-color: var(--text-muted);\r\n  border-top-width: 0;\r\n  border-bottom-width: 1px;\r\n  border-left-width: 0;\r\n  border-right-width: 1px;\r\n  transform: rotate(45deg);\r\n  opacity: 0.8;\r\n}\r\n\r\n/* Table Styles */\r\n\r\n.table-container {\r\n  width: 100%;\r\n  max-width: 100%;\r\n  overflow-x: auto;\r\n  overflow-y: hidden;\r\n  border-radius: var(--radius-md);\r\n  border: 1px solid var(--border);\r\n  background: var(--bg-panel);\r\n  -webkit-overflow-scrolling: touch;\r\n  min-width: 0;\r\n}\r\n\r\n.glass-table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n  min-width: 640px;\r\n}\r\n\r\n.glass-table th {\r\n  padding: clamp(0.75rem, 1.5vw, 1rem) clamp(0.5rem, 1.2vw, 0.75rem);\r\n  color: var(--text-muted);\r\n  font-weight: 600;\r\n  font-size: clamp(0.7rem, 0.65rem + 0.25vw, 0.85rem);\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.5px;\r\n  border-bottom: 2px solid var(--border);\r\n  text-align: center;\r\n  border-right: 1px solid rgba(255, 255, 255, 0.15);\r\n  white-space: nowrap;\r\n}\r\n\r\n.glass-table th:first-child {\r\n  /* text-align center by default now */\r\n}\r\n\r\n.glass-table th:last-child {\r\n  border-right: none;\r\n}\r\n\r\n.glass-table td {\r\n  padding: clamp(0.75rem, 1.5vw, 1rem) clamp(0.5rem, 1.2vw, 0.75rem);\r\n  border-bottom: 1px solid rgba(255, 255, 255, 0.1);\r\n  border-right: 1px solid rgba(255, 255, 255, 0.15);\r\n  text-align: center;\r\n  vertical-align: middle;\r\n  word-break: break-word;\r\n  max-width: 20rem;\r\n}\r\n\r\n.glass-table td:first-child {\r\n  /* optional: left align first child for some tables, but we can center it too */\r\n  text-align: center;\r\n}\r\n\r\n.glass-table td:last-child {\r\n  text-align: center;\r\n  border-right: none;\r\n}\r\n\r\n.glass-table tr:hover td {\r\n  background-color: rgba(255, 255, 255, 0.03);\r\n}\r\n\r\n.glass-table .empty-state {\r\n  text-align: center !important;\r\n  padding: 40px !important;\r\n  color: va