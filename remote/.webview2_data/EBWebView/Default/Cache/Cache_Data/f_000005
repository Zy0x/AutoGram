ses modal (handlers on each overlay) */\r\n  cursor: default;\r\n}\r\n\r\n@media (min-width: 540px) {\r\n  .modal-overlay {\r\n    align-items: center;\r\n    padding: 1rem;\r\n  }\r\n}\r\n\r\n.modal-content {\r\n  background: var(--bg-panel);\r\n  border: 1px solid var(--border);\r\n  border-radius: 12px 12px 0 0;\r\n  width: min(560px, calc(100vw - 16px)) !important;\r\n  min-width: min(260px, calc(100vw - 16px)) !important;\r\n  max-width: min(560px, 100vw) !important;\r\n  max-height: min(90dvh, 90vh);\r\n  height: auto !important;\r\n  display: flex !important;\r\n  flex-direction: column !important;\r\n  box-shadow: 0 10px 40px rgba(0,0,0,0.5);\r\n  overflow: hidden;\r\n  margin: 0 auto;\r\n  box-sizing: border-box !important;\r\n  writing-mode: horizontal-tb !important;\r\n}\r\n\r\n@media (min-width: 540px) {\r\n  .modal-content {\r\n    border-radius: 12px;\r\n    width: min(92vw, 560px) !important;\r\n  }\r\n}\r\n\r\n/* Generic modal panel used by RerunModal etc. */\r\n\r\n.modal-panel {\r\n  background: var(--bg-panel);\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--radius-lg);\r\n  width: min(600px, calc(100vw - 16px)) !important;\r\n  min-width: min(260px, calc(100vw - 16px)) !important;\r\n  max-width: min(92vw, 600px) !important;\r\n  max-height: min(90dvh, 90vh);\r\n  height: auto !important;\r\n  overflow-x: hidden;\r\n  overflow-y: auto;\r\n  box-sizing: border-box !important;\r\n  -webkit-overflow-scrolling: touch;\r\n  writing-mode: horizontal-tb !important;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.modal-header {\r\n  padding: clamp(0.85rem, 2vw, 1rem) clamp(1rem, 2.5vw, 1.25rem);\r\n  border-bottom: 1px solid var(--border);\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  gap: 0.75rem;\r\n  flex-wrap: wrap;\r\n  min-width: 0;\r\n  flex-shrink: 0;\r\n}\r\n\r\n.modal-header h3,\r\n.modal-header h2 {\r\n  min-width: 0;\r\n  flex: 1 1 auto;\r\n  word-break: normal;\r\n  over