rtant;\r\n}\r\n\r\n/* Absolute fill as last-resort against flex height collapse (blank black / white strip) */\r\n.app-layout-drive-focus .app-content-drive > .td-page {\r\n  position: absolute;\r\n  inset: 0;\r\n  width: 100% !important;\r\n  max-width: 100% !important;\r\n  height: 100%;\r\n  max-height: 100%;\r\n  left: 0;\r\n  right: 0;\r\n  box-sizing: border-box;\r\n  background: #0e1621 !important;\r\n}\r\n.td-main {\r\n  background: #0e1621 !important;\r\n}\r\n\r\n.td-back-autogram {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 8px;\r\n  width: 100%;\r\n  border: none;\r\n  border-bottom: 1px solid var(--td-border);\r\n  background: color-mix(in srgb, var(--td-primary) 12%, transparent);\r\n  color: var(--td-primary);\r\n  padding: 12px 14px;\r\n  font-size: 0.85rem;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n  text-align: left;\r\n  transition: background 0.12s ease;\r\n}\r\n.td-back-autogram:hover {\r\n  background: color-mix(in srgb, var(--td-primary) 22%, transparent);\r\n}\r\n.td-sidebar.collapsed .td-back-autogram {\r\n  justify-content: center;\r\n  padding: 12px 8px;\r\n}\r\n.td-back-rocket {\r\n  opacity: 0.9;\r\n  flex-shrink: 0;\r\n}\r\n\r\n\r\n/* ═══════════════════════════════════════════════════════════\r\n   Drive UI v3 — layout fix, collapsed rail, responsive topbar\r\n   ═══════════════════════════════════════════════════════════ */\r\n\r\n.td-page {\r\n  --td-bg: #0e1621;\r\n  --td-surface: #17212b;\r\n  --td-primary: #ffae00;\r\n  --td-text: #f4f6f8;\r\n  --td-sub: #8e9fb3;\r\n  --td-border: rgba(255, 255, 255, 0.1);\r\n  --td-hover: rgba(255, 255, 255, 0.06);\r\n  --td-rail: 268px;\r\n  /* Collapsed icon rail — odd width so 40px hit boxes center cleanly */\r\n  --td-rail-collapsed: 56px;\r\n  display: flex !important;\r\n  flex-direction: column !important;\r\n  flex: 1 1 auto !important;\r\n  align-self: stretch !important;\r\n  width: 100% !important;\r\n  min-width: 0 !important;\r\n  min-height: 0 !important;\r\n  height: 100% !important;\r\n  max-height: none !important;\r\n  padding: 0 !important;\r\n  margin: 0 !important;\r\n  overflow: hidden !important;\r\n  background: var(--td-bg) !important;\r\n  color: var(--td-text);\r\n  box-sizing: border-box !important;\r\n}\r\n\r\n.td-shell {\r\n  display: grid !important;\r\n  grid-template-columns: var(--td-rail) minmax(0, 1fr) !important;\r\n  grid-template-rows: minmax(0, 1fr) !important;\r\n  flex: 1 1 auto !important;\r\n  min-height: 0 !important;\r\n  min-width: 0 !important;\r\n  width: 100% !important;\r\n  max-width: 100% !important;\r\n  height: 100% !important;\r\n  overflow: hidden !important;\r\n  background: #0e1621 !important;\r\n}\r\n\r\n.td-shell.rail-collapsed {\r\n  grid-template-columns: var(--td-rail-collapsed) minmax(0, 1fr) !important;\r\n}\r\n\r\n/* ── Sidebar ── */\r\n.td-sidebar {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-height: 0;\r\n  height: 100%;\r\n  background: var(--td-surface);\r\n  border-right: 1px solid var(--td-border);\r\n  overflow: hidden;\r\n  z-index: 4;\r\n}\r\n\r\n.td-rail-head {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  padding: 8px;\r\n  border-bottom: 1px solid var(--td-border);\r\n  flex-shrink: 0;\r\n}\r\n\r\n.td-rail-btn {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  width: 100%;\r\n  min-height: 40px;\r\n  padding: 8px 10px;\r\n  border: none;\r\n  border-radius: 10px;\r\n  background: transparent;\r\n  color: var(--td-sub);\r\n  cursor: pointer;\r\n  font-size: 0.82rem;\r\n  font-weight: 600;\r\n  text-align: left;\r\n  transition: background 0.12s, color 0.12s;\r\n}\r\n.td-rail-btn:hover {\r\n  background: var(--td-hover);\r\n  color: var(--td-text);\r\n}\r\n.td-rail-btn:disabled {\r\n  opacity: 0.4;\r\n  cursor: not-allowed;\r\n}\r\n.td-rail-back {\r\n  background: color-mix(in srgb, var(--td-primary) 14%, transparent);\r\n  color: var(--td-primary);\r\n}\r\n.td-rail-back:hover {\r\n  background: color-mix(in srgb, var(--td-primary) 24%, transparent);\r\n  color: var(--td-primary);\r\n}\r\n.td-rail-btn-label {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n.td-rail-brand {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  padding: 12px 12px 8px;\r\n  flex-shrink: 0;\r\n  border: none;\r\n  background: transparent;\r\n  color: inherit;\r\n  cursor: pointer;\r\n  border-radius: 12px;\r\n  width: 100%;\r\n  text-align: left;\r\n  box-sizing: border-box;\r\n}\r\n.td-rail-brand:focus {\r\n  outline: none;\r\n}\r\n.td-rail-brand:focus-visible {\r\n  outline: 2px solid color-mix(in srgb, var(--td-primary) 45%, transparent);\r\n  outline-offset: 1px;\r\n}\r\n.td-rail-brand-toggle {\r\n  transition: background 0.12s ease;\r\n}\r\n.td-rail-brand-toggle:hover {\r\n  background: var(--td-hover);\r\n}\r\n.td-sidebar-logo {\r\n  position: relative;\r\n  width: 36px;\r\n  height: 36px;\r\n  border-radius: 10px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  flex-shrink: 0;\r\n  background: linear-gradient(135deg, rgba(255, 174, 0, 0.28), rgba(36, 129, 204, 0.22));\r\n  color: var(--td-primary);\r\n}\r\n.td-sidebar-logo-dot {\r\n  position: absolute;\r\n  bottom: -2px;\r\n  right: -2px;\r\n  width: 10px;\r\n  height: 10px;\r\n  border: 1.5px solid var(--td-surface, #0f172a);\r\n  z-index: 5;\r\n}\r\n.td-sidebar-brand-text {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: flex-start;\r\n  gap: 1px;\r\n  min-width: 0;\r\n  line-height: 1.25;\r\n}\r\n.td-sidebar-brand-text strong {\r\n  display: block;\r\n  font-size: 0.95rem;\r\n  font-weight: 700;\r\n}\r\n.td-sidebar-brand-text span {\r\n  display: block;\r\n  font-size: 0.7rem;\r\n  color: var(--td-sub);\r\n  white-space: nowrap;\r\n}\r\n\r\n.td-sidebar-session {\r\n  padding: 2px 12px 8px;\r\n  flex-shrink: 0;\r\n}\r\n.td-location-search {\r\n  margin: 0 8px 6px !important;\r\n}\r\n.td-recents {\r\n  margin-bottom: 2px !important;\r\n}\r\n\r\n.td-label {\r\n  display: block;\r\n  font-size: 0.68rem;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.04em;\r\n  color: var(--td-sub);\r\n  font-weight: 700;\r\n  margin-bottom: 4px;\r\n}\r\n.td-select,\r\n.td-sort,\r\n.td-search {\r\n  width: 100%;\r\n  background: #1a2430;\r\n  background-color: #1a2430;\r\n  border: 1px solid var(--td-border);\r\n  border-radius: 8px;\r\n  color: #f1f5f9;\r\n  font-size: 0.85rem;\r\n  padding: 8px 10px;\r\n  outline: none;\r\n  box-sizing: border-box;\r\n  color-scheme: dark;\r\n  -webkit-appearance: none;\r\n  appearance: none;\r\n  box-shadow: none;\r\n}\r\n.td-select:focus,\r\n.td-sort:focus,\r\n.td-search:focus {\r\n  border-color: color-mix(in srgb, var(--td-primary) 55%, transparent);\r\n  color: #ffffff;\r\n  box-shadow: 0 0 0 2px color-mix(in srgb, var(--td-primary) 16%, transparent);\r\n}\r\n/* Connection status handled by global .td-conn-indicator classes */\r\n\r\n/* Recent locations chips */\r\n.td-recents {\r\n  margin: 2px 2px 4px;\r\n  flex-shrink: 0;\r\n}\r\n/* Compact chrome so section headers stay inside short WebView viewports */\r\n.td-shortcuts-hint {\r\n  margin: 0 4px 4px !important;\r\n}\r\n.td-location-search {\r\n  margin-bottom: 4px !important;\r\n}\r\n.td-recents-label {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 5px;\r\n  font-size: 0.62rem;\r\n  font-weight: 700;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.04em;\r\n  color: var(--td-sub);\r\n  padding: 2px 6px 4px;\r\n}\r\n/* Terbaru / section header as collapsible toggle (matches Drives/Chats) */\r\n.td-recents-toggle {\r\n  margin: 0 0 2px !important;\r\n  width: 100% !important;\r\n  max-width: 100% !important;\r\n}\r\n.td-recents-toggle-ico {\r\n  flex: 0 0 auto;\r\n  opacity: 0.85;\r\n}\r\n.td-recents.is-collapsed-sec {\r\n  padding-bottom: 2px;\r\n}\r\n.td-recents.is-collapsed-sec .td-recents-toggle {\r\n  margin-bottom: 0 !important;\r\n}\r\n.td-recents-list {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 5px;\r\n  padding: 0 4px 2px;\r\n}\r\n.td-recent-chip {\r\n  max-width: 100%;\r\n  border: 1px solid var(--td-border);\r\n  background: color-mix(in srgb, var(--td-hover) 80%, transparent);\r\n  color: var(--td-text);\r\n  border-radius: 999px;\r\n  padding: 4px 9px;\r\n  font-size: 0.72rem;\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  transition: background 0.12s, border-color 0.12s;\r\n  /* DropRow base uses full-width folder row — keep chip layout */\r\n  width: auto !important;\r\n  min-height: 28px;\r\n  display: inline-flex !important;\r\n  align-items: center;\r\n  gap: 4px;\r\n  flex: 0 1 auto;\r\n}\r\n.td-recent-chip .td-folder-label {\r\n  flex: 0 1 auto;\r\n  max-width: 140px;\r\n}\r\n.td-recent-chip:hover {\r\n  border-color: color-mix(in srgb, var(--td-primary) 40%, var(--td-border));\r\n  background: var(--td-hover);\r\n}\r\n.td-recent-chip.active {\r\n  border-color: color-mix(in srgb, var(--td-primary) 55%, transparent);\r\n  background: color-mix(in srgb, var(--td-primary) 16%, transparent);\r\n  color: var(--td-primary);\r\n}\r\n/*\r\n * Drives stack: capped height + own scroll so a long Drive list\r\n * cannot push Chats off-screen. Chats keep flex:1 below the divider.\r\n */\r\n.td-dnd-folder-stack {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n  flex: 0 0 auto;\r\n  min-height: 0;\r\n  max-height: 50vh;\r\n  overflow-x: hidden;\r\n  overflow-y: auto;\r\n  overscroll-behavior: contain;\r\n  -webkit-overflow-scrolling: touch;\r\n  scrollbar-width: thin;\r\n  scrollbar-color: color-mix(in srgb, var(--td-primary) 35%, transparent) transparent;\r\n  padding-bottom: 2px;\r\n}\r\n.td-dnd-folder-stack::-webkit-scrollbar {\r\n  width: 6px;\r\n}\r\n.td-dnd-folder-stack::-webkit-scrollbar-thumb {\r\n  background: color-mix(in srgb, var(--td-primary) 32%, transparent);\r\n  border-radius: 6px;\r\n}\r\n/* Section header sticks while scrolling long Drive trees */\r\n.td-dnd-folder-stack > .td-section-toggle {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 2;\r\n  background: var(--td-surface);\r\n}\r\n\r\n/* ── Zone boundary: Drives vs Chats (line only — no extra icons) ── */\r\n.td-zone-divider {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  flex-shrink: 0;\r\n  width: 100%;\r\n  margin: 8px 0 4px;\r\n  padding: 0 8px;\r\n  box-sizing: border-box;\r\n  pointer-events: none;\r\n}\r\n.td-zone-divider-line {\r\n  display: block;\r\n  width: 100%;\r\n  height: 1px;\r\n  border-radius: 1px;\r\n  background: linear-gradient(\r\n    90deg,\r\n    transparent 0%,\r\n    var(--td-border) 18%,\r\n    color-mix(in srgb, var(--td-border) 85%, var(--td-primary) 15%) 50%,\r\n    var(--td-border) 82%,\r\n    transparent 100%\r\n  );\r\n  opacity: 0.9;\r\n}\r\n/* Expanded: soft gap + line between Drive list and Chats header */\r\n.td-sidebar:not(.is-collapsed):not(.collapsed) .td-zone-divider {\r\n  margin: 10px 4px 6px;\r\n  padding: 0 6px;\r\n}\r\n.td-shortcuts-hint {\r\n  margin: 0 6px 6px;\r\n  font-size: 0.6rem;\r\n  line-height: 1.35;\r\n  color: color-mix(in srgb, var(--td-sub) 90%, transparent);\r\n  opacity: 0.88;\r\n  flex-shrink: 0;\r\n  /* One tidy line — avoid multi-line wrap “berantakan” */\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  max-width: 100%;\r\n}\r\n.td-shortcuts-hint kbd {\r\n  display: inline-block;\r\n  padding: 0 4px;\r\n  border-radius: 3px;\r\n  border: 1px solid var(--td-border);\r\n  background: rgba(0, 0, 0, 0.22);\r\n  font-size: 0.58rem;\r\n  font-family: inherit;\r\n  font-weight: 650;\r\n}\r\n/* Hide noisy shortcut strip on short rails */\r\n@media (max-height: 720px) {\r\n  .td-shortcuts-hint {\r\n    display: none;\r\n  }\r\n}\r\n\r\n/* Lazy Media Studio chunk load */\r\n.td-boot-fallback {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-height: 40vh;\r\n  padding: 24px;\r\n  color: var(--td-sub, #94a3b8);\r\n  font-size: 0.9rem;\r\n  font-weight: 600;\r\n}\r\n\r\n/* Compact 1-row action panel — frees vertical space for folders/chats */\r\n.td-rail-actions {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n  padding: 4px 8px 8px;\r\n  border-bottom: 1px solid var(--td-border);\r\n  flex-shrink: 0;\r\n}\r\n.td-rail-actions.td-rail-toolbar {\r\n  flex-direction: row;\r\n  align-items: stretch;\r\n  gap: 6px;\r\n  padding: 6px 8px 8px;\r\n}\r\n.td-rail-toolbar .td-rail-tool {\r\n  flex: 1 1 0;\r\n  width: auto;\r\n  min-width: 0;\r\n  min-height: 34px;\r\n  max-height: 38px;\r\n  padding: 6px 8px;\r\n  gap: 6px;\r\n  justify-content: center;\r\n  border-radius: 9px;\r\n  border: 1px solid var(--td-border);\r\n  background: color-mix(in srgb, var(--td-hover) 70%, transparent);\r\n  font-size: 0.78rem;\r\n  font-weight: 650;\r\n  letter-spacing: 0.01em;\r\n}\r\n.td-rail-toolbar .td-rail-tool:hover:not(:disabled) {\r\n  background: var(--td-hover);\r\n  border-color: color-mix(in srgb, var(--td-primary) 35%, var(--td-border));\r\n  color: var(--td-text);\r\n}\r\n.td-rail-toolbar .td-rail-tool:focus-visible {\r\n  outline: 2px solid color-mix(in srgb, var(--td-primary) 50%, transparent);\r\n  outline-offset: 1px;\r\n}\r\n.td-rail-toolbar .td-rail-tool .td-rail-btn-label {\r\n  font-size: 0.75rem;\r\n  font-weight: 650;\r\n}\r\n/* Icon-only when rail is very narrow (still readable hit target ~34px) */\r\n@media (max-width: 360px) {\r\n  .td-rail-toolbar .td-rail-tool .td-rail-btn-label {\r\n    display: none;\r\n  }\r\n  .td-rail-toolbar .td-rail-tool {\r\n    min-height: 36px;\r\n    padding: 8px;\r\n  }\r\n}\r\n\r\n/*\r\n * Nav column: chrome (saved/recents) can scroll if needed, but primary\r\n * lists (Drives stack + Chats virtual) own their own scrollports so\r\n * neither section can fully bury the other.\r\n */\r\n.td-folder-nav {\r\n  flex: 1 1 0;\r\n  min-height: 0;\r\n  overflow-x: hidden;\r\n  overflow-y: auto;\r\n  padding: 6px 8px 8px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n  scrollbar-gutter: auto;\r\n  -webkit-overflow-scrolling: touch;\r\n}\r\n/* When both sections are open, allow them to grow and force parent scroll */\r\n.td-folder-nav:not(.chats-collapsed) .td-chat-virtual {\r\n  flex: 0 0 auto;\r\n  min-height: min(140px, 24vh);\r\n  max-height: 50vh;\r\n}\r\n.td-section-label {\r\n  font-size: 0.65rem;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.05em;\r\n  color: var(--td-sub);\r\n  font-weight: 700;\r\n  padding: 10px 8px 4px;\r\n}\r\n\r\n/* Expand/collapse section headers (Drives / Chats) — always flex row */\r\n.td-section-toggle {\r\n  display: flex !important;\r\n  flex-direction: row !important;\r\n  align-items: center !important;\r\n  justify-content: flex-start;\r\n  gap: 8px;\r\n  width: calc(100% - 8px);\r\n  max-width: 100%;\r\n  margin: 4px 4px 2px;\r\n  padding: 6px 8px;\r\n  min-height: 32px;\r\n  box-sizing: border-box;\r\n  border: 1px solid transparent;\r\n  border-radius: 8px;\r\n  background: transparent;\r\n  color: var(--td-sub);\r\n  font-size: 0.65rem;\r\n  font-weight: 700;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.04em;\r\n  cursor: pointer;\r\n  text-align: left;\r\n  flex-shrink: 0;\r\n  transition: background 0.12s ease, color 0.12s ease, border-color 0.12s ease;\r\n}\r\n.td-section-toggle:hover {\r\n  background: var(--td-hover);\r\n  color: var(--td-text);\r\n}\r\n.td-section-toggle:focus-visible {\r\n  outline: 2px solid color-mix(in srgb, var(--td-primary) 55%, transparent);\r\n  outline-offset: 1px;\r\n}\r\n.td-section-toggle-label {\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  line-height: 1.2;\r\n}\r\n/* Chevron sits in a fixed square so it never drifts on small drawers */\r\n.td-section-che