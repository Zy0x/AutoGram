ar(--text-muted);\r\n  font-size: var(--fs-sm);\r\n  line-height: 1.55;\r\n}\r\n.dash-pillar .btn {\r\n  align-self: flex-start;\r\n  margin-top: 0.25rem;\r\n}\r\n.dash-section-title {\r\n  margin: 0 0 0.75rem;\r\n  font-size: var(--fs-md);\r\n}\r\n.dash-steps-list {\r\n  margin: 0;\r\n  padding-left: 0;\r\n  list-style: none;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0.65rem;\r\n  color: var(--text-muted);\r\n  font-size: var(--fs-sm);\r\n  line-height: 1.5;\r\n}\r\n.dash-step-link {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 0.35rem;\r\n  background: transparent;\r\n  border: none;\r\n  color: var(--primary);\r\n  font-weight: 600;\r\n  cursor: pointer;\r\n  padding: 0;\r\n  font-size: inherit;\r\n}\r\n.dash-step-link:disabled {\r\n  opacity: 0.45;\r\n  cursor: not-allowed;\r\n}\r\n.dash-safety-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\r\n  gap: 1rem;\r\n  font-size: var(--fs-sm);\r\n  color: var(--text-muted);\r\n  line-height: 1.45;\r\n}\r\n.dash-safety-grid strong {\r\n  color: var(--text-main);\r\n}\r\n.dash-safety-grid p {\r\n  margin: 0.35rem 0 0;\r\n}\r\n\r\n/* ==========================================\r\n   Drive-Style Modern & Elegant In-ZIP Browser (Override)\r\n   ========================================== */\r\n\r\n.drive-zip-browser {\r\n  display: flex;\r\n  flex-direction: column;\r\n  height: 100%;\r\n  min-height: 0;\r\n  color: var(--td-text, #f8fafc);\r\n  background: #0b1120;\r\n  font-family: inherit;\r\n  overflow: hidden;\r\n}\r\n.drive-zip-browser.is-loading,\r\n.drive-zip-browser.is-error {\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 12px;\r\n  padding: 32px;\r\n  text-align: center;\r\n}\r\n\r\n/* Header */\r\n.drive-zip-head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  padding: 10px 16px;\r\n  background: rgba(15, 23, 42, 0.85);\r\n  backdrop-filter: blur(12px);\r\n  b