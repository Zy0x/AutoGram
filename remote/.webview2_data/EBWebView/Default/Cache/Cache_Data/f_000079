4.5rem;\r\n}\r\n\r\n.log-text {\r\n  word-break: break-word;\r\n  overflow-wrap: anywhere;\r\n  flex: 1 1 auto;\r\n  min-width: 0;\r\n}\r\n\r\n@media (max-width: 479.98px) {\r\n  .log-time {\r\n    min-width: 3.25rem;\r\n  }\r\n}\r\n\r\n/* Job editor */\r\n.job-editor-container {\r\n  padding: var(--content-pad);\r\n  padding-bottom: 0;\r\n  overflow: hidden;\r\n  height: 100%;\r\n  max-height: 100%;\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n  min-height: 0;\r\n  box-sizing: border-box;\r\n  flex: 1 1 auto;\r\n}\r\n\r\n.job-editor-header {\r\n  flex-shrink: 0;\r\n  margin-bottom: 1.25rem;\r\n  min-width: 0;\r\n}\r\n\r\n.job-editor-header-top {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  justify-content: space-between;\r\n  align-items: flex-start;\r\n  gap: 1rem;\r\n  margin-bottom: 1.25rem;\r\n  min-width: 0;\r\n}\r\n\r\n.job-editor-tools {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 0.5rem 0.75rem;\r\n  align-items: center;\r\n  min-width: 0;\r\n  /* Hug content — do not steal remaining header width */\r\n  flex: 0 1 auto;\r\n  justify-content: flex-end;\r\n  max-width: 100%;\r\n}\r\n\r\n/*\r\n * Profile load control group:\r\n * [ Load Profile ▾ ]           → compact alone\r\n * [ Tes Clean ▾ | 🗑 ]        → trash only when loaded, attached flush\r\n */\r\n.job-editor-tools .profile-load-row {\r\n  display: inline-flex;\r\n  flex-direction: row;\r\n  flex-wrap: nowrap;\r\n  align-items: stretch;\r\n  gap: 0;\r\n  min-width: 0;\r\n  max-width: 100%;\r\n  flex: 0 1 auto;\r\n  border-radius: var(--radius-sm);\r\n  border: 1px solid var(--border);\r\n  background: rgba(0, 0, 0, 0.3);\r\n  overflow: hidden;\r\n}\r\n\r\n.job-editor-tools .profile-select-wrap {\r\n  flex: 1 1 auto;\r\n  width: auto;\r\n  min-width: 9.5rem;\r\n  max-width: 15rem;\r\n}\r\n\r\n.job-editor-tools .profile-select-wrap .select-container {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n\r\n/* Flatten Select look so it blends into the control group */\r\n.job-editor-tools .profile-select-wrap .input-field {\r\n  width: 100%;\r\n  min-width: 0;\r\n  height: 100%;\r\n  min-height: 2.5rem;\r\n  border: none !important;\r\n  border-radius: 0 !important;\r\n  background: transparent !important;\r\n  box-shadow: none !important;\r\n}\r\n\r\n.job-editor-tools .profile-load-row.is-loaded .profile-select-wrap .input-field {\r\n  border-right: 1px solid var(--border) !important;\r\n}\r\n\r\n.job-editor-tools .profile-delete-btn {\r\n  flex: 0 0 auto;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 2.5rem;\r\n  min-width: 2.5rem;\r\n  min-height: 2.5rem;\r\n  margin: 0;\r\n  padding: 0;\r\n  border: none;\r\n  border-radius: 0;\r\n  background: rgba(239, 68, 68, 0.12);\r\n  color: var(--danger);\r\n  cursor: pointer;\r\n  transition: background 0.15s ease, color 0.15s ease;\r\n}\r\n\r\n.job-editor-tools .profile-delete-btn:hover {\r\n  background: rgba(239, 68, 68, 0.28);\r\n  color: #fecaca;\r\n}\r\n\r\n.job-editor-tools .profile-delete-btn:active {\r\n  background: rgba(239, 68, 68, 0.4);\r\n}\r\n\r\n.job-editor-tools .profile-delete-btn:focus-visible {\r\n  outline: 2px solid var(--danger);\r\n  outline-offset: -2px;\r\n}\r\n\r\n.job-editor-tools .profile-name-input {\r\n  width: auto;\r\n  min-width: min(100%, 8rem);\r\n  max-width: min(100%, 14rem);\r\n  flex: 1 1 8rem;\r\n  padding: 0.5rem 0.75rem;\r\n}\r\n\r\n.job-editor-scroll-area {\r\n  flex: 1 1 auto;\r\n  display: flex;\r\n  flex-direction: column;\r\n  overflow-y: auto;\r\n  overflow-x: hidden;\r\n  min-height: 0;\r\n  padding-right: 0.25rem;\r\n  padding-bottom: 1.5rem;\r\n  -webkit-overflow-scrolling: touch;\r\n}\r\n\r\n.stepper {\r\n  display: flex;\r\n  gap: 0.5rem 0.75rem;\r\n  align-items: stretch;\r\n  min-width: 0;\r\n  overflow-x: auto;\r\n  padding-bottom: 0.25rem;\r\n  -webkit-overflow-scrolling: touch;\r\n}\r\n\r\n.stepper-item {\r\n  flex: 1 1 4rem;\r\n  min-width: 4.5rem;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 0.5rem;\r\n  position: relative;\r\n}\r\n\r\n/* ---------- Action groups (shared) ---------- */\r\n.action-group {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 0.5rem 0.75rem;\r\n  padding: 0.75rem 1rem;\r\n  background: rgba(255, 255, 255, 0.02);\r\n  border-radius: 12px;\r\n  border: 1px solid rgba(255, 255, 255, 0.06);\r\n  align-items: center;\r\n  min-width: 0;\r\n}\r\n\r\n.primary-actions,\r\n.secondary-actions,\r\n.danger-actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 0.5rem;\r\n  min-width: 0;\r\n}\r\n\r\n.secondary-actions {\r\n  margin-left: 0;\r\n}\r\n\r\n.danger-actions {\r\n  margin-left: 0;\r\n  border-left: none;\r\n  padding-left: 0;\r\n  border-top: 1px solid rgba(255, 0, 0, 0.1);\r\n  padding-top: 0.5rem;\r\n  width: 100%;\r\n}\r\n\r\n@media (min-width: 720px) {\r\n  .secondary-actions {\r\n    margin-left: auto;\r\n  }\r\n\r\n  .danger-actions {\r\n    margin-left: 1rem;\r\n    border-left: 1px solid rgba(255, 0, 0, 0.1);\r\n    border-top: none;\r\n    padding-left: 1rem;\r\n    padding-top: 0;\r\n    width: auto;\r\n  }\r\n}\r\n\r\n/* ---------- Animations ---------- */\r\n@keyframes spin {\r\n  from { transform: rotate(0deg); }\r\n  to { transform: rotate(360deg); }\r\n}\r\n\r\n.spin {\r\n  animation: spin 1s linear infinite;\r\n}\r\n\r\n@keyframes fadeIn {\r\n  from { opacity: 0; transform: translateY(4px); }\r\n  to { opacity: 1; transform: translateY(0); }\r\n}\r\n\r\n.fade-in {\r\n  animation: fadeIn 0.25s ease-out;\r\n}\r\n\r\n/* Root resets for layout */\r\n#root {\r\n  margin: 0;\r\n  padding: 0;\r\n  text-align: left;\r\n  width: 100%;\r\n  max-width: 100vw;\r\n  height: 100dvh;\r\n  min-height: 100dvh;\r\n  overflow: hidden;\r\n}\r\n\r\n/* Utility: hide text on very small if needed */\r\n/* ---------- Shared page utilities ---------- */\r\n.page-stack {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: var(--content-gap);\r\n  min-width: 0;\r\n  width: 100%;\r\n  /* room so last cards are never clipped by bottom nav / window edge */\r\n  padding-bottom: clamp(2rem, 6vh, 4rem);\r\n}\r\n\r\n/* ── AutoGram Drive — Telegram-Drive full layout ─────────── */\r\n.td-page {\r\n  --td-bg: #0e1621;\r\n  --td-surface: #17212b;\r\n  --td-surface-2: #1c2733;\r\n  --td-primary: #ffae00;\r\n  --td-accent: #2481cc;\r\n  --td-text: #ffffff;\r\n  --td-sub: #8e9fb3;\r\n  --td-border: rgba(255, 255, 255, 0.1);\r\n  --td-hover: rgba(255, 255, 255, 0.05);\r\n  flex: 1 1 0;\r\n  min-height: 0;\r\n  height: 100%;\r\n  padding: 0 !important;\r\n  background: var(--td-bg);\r\n  color: var(--td-text);\r\n  overflow: hidden;\r\n}\r\n\r\n.td-shell {\r\n  display: grid;\r\n  grid-template-columns: 260px 1fr;\r\n  height: 100%;\r\n  min-height: 0;\r\n  width: 100%;\r\n}\r\n\r\n@media (max-width: 900px) {\r\n  .td-shell {\r\n    grid-template-columns: 1fr;\r\n    grid-template-rows: auto 1fr;\r\n  }\r\n  .td-sidebar {\r\n    max-height: 40vh;\r\n    border-right: none !important;\r\n    border-bottom: 1px solid var(--td-border);\r\n  }\r\n}\r\n\r\n.td-sidebar {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-height: 0;\r\n  background: var(--td-surface);\r\n  border-right: 1px solid var(--td-border);\r\n}\r\n\r\n.td-sidebar-brand {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 12px;\r\n  padding: 16px 14px 12px;\r\n  border-bottom: 1px solid var(--td-border);\r\n}\r\n\r\n.td-sidebar-logo {\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 12px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  background: linear-gradient(135deg, rgba(255, 174, 0, 0.25), rgba(36, 129, 204, 0.25));\r\n  color: var(--td-primary);\r\n  flex-shrink: 0;\r\n}\r\n\r\n.td-sidebar-brand-text {\r\n  display: flex;\r\n  flex-direction: column;\r\n  min-width: 0;\r\n  line-height: 1.25;\r\n}\r\n\r\n.td-sidebar-brand-text strong {\r\n  font-size: 0.95rem;\r\n  font-weight: 700;\r\n}\r\n\r\n.td-sidebar-brand-text span {\r\n  font-size: 0.72rem;\r\n  color: var(--td-sub);\r\n}\r\n\r\n.td-sidebar-session {\r\n  padding: 12px 14px;\r\n  border-bottom: 1px solid var(--td-border);\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n}\r\n\r\n.td-label {\r\n  font-size: 0.7rem;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.04em;\r\n  color: var(--td-sub);\r\n  font-weight: 600;\r\n}\r\n\r\n.td-select,\r\n.td-sort,\r\n.td-search {\r\n  background: #1a2430;\r\n  background-color: #1a2430;\r\n  border: 1px solid var(--td-border);\r\n  border-radius: 8px;\r\n  color: #f1f5f9;\r\n  font-size: 0.85rem;\r\n  padding: 7px 10px;\r\n  outline: none;\r\n  color-scheme: dark;\r\n  -webkit-appearance: none;\r\n  appearance: none;\r\n  box-shadow: none;\r\n}\r\n\r\n.td-select:focus,\r\n.td-sort:focus,\r\n.td-search:focus {\r\n  border-color: color-mix(in srgb, var(--td-primary) 50%, transparent);\r\n  color: #ffffff;\r\n}\r\n\r\n/* Native <option> list: prevent white text on light OS popup */\r\n.td-select option,\r\n.td-sort option {\r\n  background: #1a2430;\r\n  background-color: #1a2430;\r\n  color: #f8fafc;\r\n  font-weight: 600;\r\n}\r\n.td-select option:checked,\r\n.td-sort option:checked {\r\n  background-color: #2a4a6b;\r\n  color: #ffffff;\r\n}\r\n\r\n.td-conn-indicator {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  margin-top: 6px;\r\n  font-size: 0.72rem;\r\n  color: var(--td-sub, #94a3b8);\r\n  font-weight: 600;\r\n}\r\n\r\n.td-conn-dot {\r\n  width: 7px;\r\n  height: 7px;\r\n  border-radius: 50%;\r\n  flex-shrink: 0;\r\n  transition: background-color 0.25s ease, box-shadow 0.25s ease;\r\n}\r\n\r\n/* Status colors and pulsing */\r\n.td-conn-dot.excellent {\r\n  background-color: #10b981; /* Emerald Green */\r\n  box-shadow: 0 0 6px rgba(16, 185, 129, 0.6);\r\n}\r\n.td-conn-dot.good {\r\n  background-color: #84cc16; /* Lime Green */\r\n  box-shadow: 0 0 6px rgba(132, 204, 22, 0.6);\r\n}\r\n.td-conn-dot.fair {\r\n  background-color: #eab308; /* Yellow */\r\n  box-shadow: 0 0 6px rgba(234, 179, 8, 0.6);\r\n}\r\n.td-conn-dot.poor {\r\n  background-color: #f97316; /* Orange */\r\n  box-shadow: 0 0 6px rgba(249, 115, 22, 0.6);\r\n}\r\n.td-conn-dot.disconnected {\r\n  background-color: #ef4444; /* Red */\r\n  box-shadow: 0 0 6px rgba(239, 68, 68, 0.6);\r\n}\r\n.td-conn-dot.offline {\r\n  background-color: #6b7280; /* Gray */\r\n  box-shadow: 0 0 6px rgba(107, 114, 128, 0.6);\r\n}\r\n.td-conn-dot.transferring {\r\n  background-color: #38bdf8; /* Sky Blue */\r\n  box-shadow: 0 0 6px rgba(56, 189, 248, 0.6);\r\n}\r\n\r\n/* Pulsing effect */\r\n.td-conn-dot.pulse {\r\n  animation: conn-pulse 2s infinite ease-in-out;\r\n}\r\n@keyframes conn-pulse {\r\n  0%, 100% {\r\n    transform: scale(1);\r\n    opacity: 1;\r\n  }\r\n  50% {\r\n    transform: scale(1.15);\r\n    opacity: 0.8;\r\n  }\r\n}\r\n\r\n/* Collapsed rail indicators */\r\n.td-rail-conn-indicator {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  width: 100%;\r\n  margin: 4px 0 2px;\r\n  padding: 4px 0;\r\n  cursor: help;\r\n}\r\n\r\n.td-rail-conn-dot {\r\n  width: 8px;\r\n  height: 8px;\r\n  border-radius: 50%;\r\n  transition: background-color 0.25s ease, box-shadow 0.25s ease;\r\n}\r\n.td-rail-conn-dot.excellent {\r\n  background-color: #10b981;\r\n  box-shadow: 0 0 6px rgba(16, 185, 129, 0.55);\r\n}\r\n.td-rail-conn-dot.good {\r\n  background-color: #84cc16;\r\n  box-shadow: 0 0 6px rgba(132, 204, 22, 0.55);\r\n}\r\n.td-rail-conn-dot.fair {\r\n  background-color: #eab308;\r\n  box-shadow: 0 0 6px rgba(234, 179, 8, 0.55);\r\n}\r\n.td-rail-conn-dot.poor {\r\n  background-color: #f97316;\r\n  box-shadow: 0 0 6px rgba(249, 115, 22, 0.55);\r\n}\r\n.td-rail-conn-dot.disconnected {\r\n  background-color: #ef4444;\r\n  box-shadow: 0 0 6px rgba(239, 68, 68, 0.55);\r\n}\r\n.td-rail-conn-dot.offline {\r\n  background-color: #6b7280;\r\n  box-shadow: 0 0 6px rgba(107, 114, 128, 0.55);\r\n}\r\n.td-rail-conn-dot.transferring {\r\n  background-color: #38bdf8;\r\n  box-shadow: 0 0 6px rgba(56, 189, 248, 0.55);\r\n}\r\n.td-rail-conn-dot.pulse {\r\n  animation: conn-pulse 2s infinite ease-in-out;\r\n}\r\n\r\n.td-sidebar-section-head {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 12px 14px 6px;\r\n  font-size: 0.72rem;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.05em;\r\n  color: var(--td-sub);\r\n  font-weight: 700;\r\n}\r\n\r\n.td-sidebar-section-actions {\r\n  display: flex;\r\n  gap: 2px;\r\n}\r\n\r\n/* Early base — chat list owns scroll; do not set overflow-y:auto here */\r\n.td-folder-nav {\r\n  flex: 1 1 0;\r\n  min-height: 0;\r\n  overflow-y: auto;\r\n  overflow-x: hidden;\r\n  padding: 4px 8px 12px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 2px;\r\n  scrollbar-width: thin;\r\n  scrollbar-color: color-mix(in srgb, var(--td-primary) 35%, transparent) transparent;\r\n}\r\n\r\n.td-folder-nav::-webkit-scrollbar {\r\n  width: 6px;\r\n}\r\n.td-folder-nav::-webkit-scrollbar-thumb {\r\n  background: color-mix(in srgb, var(--td-primary) 32%, transparent);\r\n  border-radius: 6px;\r\n}\r\n\r\n.td-folder-row {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  width: 100%;\r\n  border: none;\r\n  background: transparent;\r\n  color: var(--td-text);\r\n  padding: 9px 10px;\r\n  border-radius: 10px;\r\n  cursor: pointer;\r\n  text-align: left;\r\n  font-size: 0.9rem;\r\n  transition: background 0.12s ease;\r\n}\r\n\r\n.td-folder-row:hover {\r\n  background: var(--td-hover);\r\n}\r\n\r\n.td-folder-row.active {\r\n  background: color-mix(in srgb, var(--td-primary) 18%, transparent);\r\n  color: var(--td-primary);\r\n  font-weight: 600;\r\n}\r\n\r\n/* Drag-and-drop: NO full-area green block — only the hovered row turns green */\r\n.td-folder-row {\r\n  user-select: none;\r\n  -webkit-user-select: none;\r\n  transition: background 0.08s ease, box-shadow 0.08s ease, border-color 0.08s ease, transform 0.08s ease;\r\n  border: 1px solid transparent;