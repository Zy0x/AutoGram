tant;\r\n  filter: none !important;\r\n  background: transparent !important;\r\n  cursor: not-allowed;\r\n  box-shadow: none !important;\r\n}\r\n/* Sidebar during drag: identical surface to idle (no inset glow / no outer shadow).\r\n * z-index MUST stay above .td-drawer-backdrop (65) and open drawer rail (70).\r\n * Previously z-index:40 put the rail *under* the 50% black drawer scrim → looked half-dark. */\r\n.td-sidebar.media-dnd,\r\n.td-shell.is-media-dnd .td-sidebar {\r\n  z-index: 80 !important;\r\n  background: var(--td-surface) !important;\r\n  box-shadow: none !important;\r\n  filter: none !important;\r\n  opacity: 1 !important;\r\n  border-right: 1px solid var(--td-border);\r\n}\r\n/* Never dim the UI with the mobile drawer scrim while dragging media */\r\n.td-page.is-internal-dnd .td-drawer-backdrop,\r\nbody.td-dnd-internal .td-drawer-backdrop {\r\n  display: none !important;\r\n  pointer-events: none !important;\r\n  opacity: 0 !important;\r\n  background: transparent !important;\r\n}\r\n.td-sidebar.media-dnd .td-rail-actions,\r\n.td-sidebar.media-dnd .td-sidebar-session,\r\n.td-sidebar.media-dnd .td-rail-head,\r\n.td-sidebar.media-dnd .td-sidebar-foot {\r\n  pointer-events: none !important;\r\n  opacity: 1 !important;\r\n  filter: none !important;\r\n  background: var(--td-surface) !important;\r\n}\r\n/* Keep shortcuts/search visible — less “mode change” feel */\r\n.td-sidebar.media-dnd .td-shortcuts-hint {\r\n  display: none !important; /* still hide only the long Ctrl chips row if crowded */\r\n}\r\n.td-sidebar.media-dnd .td-folder-nav.is-dnd-layout {\r\n  display: flex !important;\r\n  flex-direction: column !important;\r\n  overflow-x: hidden;\r\n  overflow-y: auto;\r\n  overscroll-behavior: contain;\r\n  background: var(--td-surface) !important;\r\n  opacity: 1 !important;\r\n  filter: none !important;\r\n  /* Split remaining height between Drives stack + Chats list */\r\n  min-height: 0;\r\n}\r\n/*\r\n * DnD layout on small windows (SS 231555): Cha