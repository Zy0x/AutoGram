inset: 0; z-index: 9200;\r\n  display: flex; align-items: center; justify-content: center;\r\n  background: rgba(0,0,0,0.55); backdrop-filter: blur(4px);\r\n  padding: 1rem; animation: rub-fade-in 0.18s ease;\r\n}\r\n@keyframes rub-fade-in { from { opacity: 0; } to { opacity: 1; } }\r\n.rub-modal {\r\n  background: var(--td-panel, #1e1e1e); border: 1px solid var(--td-border, #2e2e2e);\r\n  border-radius: 12px; box-shadow: 0 24px 56px rgba(0,0,0,0.55);\r\n  width: 100%; max-width: 520px; max-height: 82vh; display: flex; flex-direction: column;\r\n  animation: rub-slide-up 0.2s cubic-bezier(0.34,1.56,0.64,1);\r\n}\r\n@keyframes rub-slide-up { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }\r\n.rub-head { display: flex; align-items: flex-start; gap: 0.75rem; padding: 1rem 1rem 0.75rem; border-bottom: 1px solid var(--td-border, #2e2e2e); }\r\n.rub-head-icon { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 8px; background: rgba(251,146,60,0.12); color: #fb923c; flex-shrink: 0; }\r\n.rub-title { margin: 0 0 2px; font-size: 0.95rem; font-weight: 700; color: var(--td-text, #f0f0f0); }\r\n.rub-subtitle { margin: 0; font-size: 0.78rem; color: var(--td-sub, #888); line-height: 1.45; }\r\n.rub-close { margin-left: auto; background: none; border: none; color: var(--td-sub, #888); cursor: pointer; padding: 4px; border-radius: 5px; transition: color 0.15s, background 0.15s; flex-shrink: 0; }\r\n.rub-close:hover { color: var(--td-text, #f0f0f0); background: var(--td-hover, rgba(255,255,255,0.06)); }\r\n.rub-info { display: flex; align-items: flex-start; gap: 6px; padding: 0.6rem 1rem; font-size: 0.74rem; color: var(--td-sub, #888); background: color-mix(in srgb, #fb923c 5%, transparent); border-bottom: 1px solid var(--td-border, #2e2e2e); line-height: 1.45; }\r\n.rub-info svg { flex-shrink: 0; margin-top: 2px; color: #fb923c; }\r\n.rub-list-wrap { flex: 1; overflow-y: auto; padd