{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/target/**": true,
    "**/dist/**": true,
    "**/scratch/**": true,
    "**/.gemini/**": true
  },
  "typescript.tsserver.maxTsServerMemory": 512,
  "rust-analyzer.check.command": "check",
  "rust-analyzer.files.excludeDirs": [
    "target",
    "node_modules",
    "scratch",
    ".gemini"
  ]
}
