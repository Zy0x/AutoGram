{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:1420/**",
      "http://127.0.0.1:1420/**"
    ]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "shell:default",
    "dialog:default",
    "fs:default",
    "allow-custom-commands",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$HOME/Downloads/**" },
        { "path": "$HOME/Documents/**" },
        { "path": "$HOME/Desktop/**" }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DOWNLOAD/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$HOME/Downloads/**" },
        { "path": "$HOME/Documents/**" },
        { "path": "$HOME/Desktop/**" },
        { "path": "$APPDATA/**" },
        { "path": "$APPLOCALDATA/**" },
        { "path": "$TEMP/**" },
        { "path": "$RESOURCE/**" },
        { "path": "**/worker/temp/**" },
        { "path": "**/worker/cache/**" },
        { "path": "**/worker/logs/**" }
      ]
    }
  ]
}
